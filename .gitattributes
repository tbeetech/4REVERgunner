# Normalize line endings to LF for text files
* text=auto eol=lf

# Godot scene and resource files are text
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.gdshader text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.svg binary
*.ico binary
*.mp3 binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary

# Git LFS hints (uncomment and configure Git LFS if you want to track these with LFS)
# *.png filter=lfs diff=lfs merge=lfs -text
